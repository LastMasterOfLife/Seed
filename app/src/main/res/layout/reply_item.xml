<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/reply_background">


    <!-- Riga principale del commento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <!-- Icona "+" o "-" -->
        <ImageView
            android:id="@+id/toggleIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/plus_icon"
            android:layout_gravity="center_vertical" />


        <!-- Immagine profilo utente -->
        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ohma_tokita"
            android:scaleType="centerCrop" />


        <!-- Contenitore testo -->
        <LinearLayout
            android:id="@+id/replyContentContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">


            <!-- Nome utente -->
            <TextView
                android:id="@+id/usernameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome Utente"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />


            <!-- Testo della risposta -->
            <TextView
                android:id="@+id/replyTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Questo è un esempio di risposta"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>


        <!-- Icone di interazione -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical">


            <ImageView
                android:id="@+id/likeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/like_icon" />


            <ImageView
                android:id="@+id/replyIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/reply_icon" />
        </LinearLayout>
    </LinearLayout>


    <!-- Contenitore input per sotto-commento -->
    <LinearLayout
        android:id="@+id/subCommentInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="8dp"
        android:layout_marginStart="40dp">


        <EditText
            android:id="@+id/subCommentEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Scrivi un sotto-commento"
            android:background="@android:color/white"
            android:padding="8dp"
            android:textColor="@android:color/black" />


        <Button
            android:id="@+id/sendSubCommentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invia"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white" />
    </LinearLayout>


    <!-- Contenitore per i sotto-commenti -->
    <LinearLayout
        android:id="@+id/subCommentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="40dp"
        android:visibility="gone" />
</LinearLayout>
