<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@android:color/transparent"
    android:layout_marginStart="40dp">


    <!-- Icona "+" o "-" -->


    <!-- Immagine profilo utente -->
    <ImageView
        android:id="@+id/profileImageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/baki_hanma"
        android:layout_gravity="center_vertical" />


    <!-- Contenitore testo -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">


        <!-- Nome utente -->
        <TextView
            android:id="@+id/usernameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome Utente"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />


        <!-- Testo sotto-commento -->
        <TextView
            android:id="@+id/subCommentTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Testo del sotto-commento"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">


        <ImageView
            android:id="@+id/likeIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/like_icon"
            />


        <ImageView
            android:id="@+id/replyIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/reply_icon"
            />
    </LinearLayout>
</LinearLayout>
