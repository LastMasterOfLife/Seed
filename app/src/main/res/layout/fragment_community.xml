<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.CommunityFragment"
    android:background="@color/secondary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Main background card -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/topGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.25" />

        <View
            android:id="@+id/backgroundView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:background="@drawable/border"
            android:backgroundTint="@color/background"
            app:layout_constraintTop_toTopOf="@id/topGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.35" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/message"
            android:textSize="18sp"
            android:ellipsize="end"
            android:maxLines="5"
            android:padding="@dimen/padding_large"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeStepGranularity="2sp"
            app:layout_constraintBottom_toBottomOf="@id/backgroundView"
            app:layout_constraintEnd_toEndOf="@id/backgroundView"
            app:layout_constraintStart_toStartOf="@id/backgroundView"
            app:layout_constraintTop_toBottomOf="@id/baki_hanma_icon"
            android:layout_marginTop="@dimen/margin_small" />

        <!-- User info section -->
        <ImageView
            android:id="@+id/baki_hanma_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:adjustViewBounds="true"
            app:layout_constraintWidth_percent="0.12"
            android:src="@drawable/baki_hanma"
            app:layout_constraintStart_toStartOf="@id/backgroundView"
            app:layout_constraintTop_toTopOf="@id/backgroundView" />

        <TextView
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/nome_utente"
            android:textColorHint="@color/black"
            android:layout_marginStart="@dimen/margin_medium"
            app:layout_constraintStart_toEndOf="@id/baki_hanma_icon"
            app:layout_constraintTop_toTopOf="@id/baki_hanma_icon"
            app:layout_constraintBottom_toBottomOf="@id/baki_hanma_icon" />

        <!-- Interaction buttons -->
        <LinearLayout
            android:id="@+id/interactionLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/backgroundView"
            app:layout_constraintTop_toBottomOf="@id/textView">

            <ImageView
                android:id="@+id/likeIcon"
                android:layout_width="wrap_content"
                android:src="@drawable/like_icon"
                android:clickable="true"
                android:focusable="true"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                 />


            <ImageView
                android:id="@+id/reply_icon"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_large"
                android:src="@drawable/reply_icon" />


        </LinearLayout>

        <!-- Reply section -->
        <ImageView
            android:id="@+id/ohma_tokita_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginTop="60dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ohma_tokita"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/interactionLayout"
            app:layout_constraintWidth_percent="0.12" />
        <EditText
            android:id="@+id/hiddenEditText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:inputType="text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/nome_utente2"
            android:textColorHint="@color/black"
            android:layout_marginStart="@dimen/margin_medium"
            app:layout_constraintStart_toEndOf="@id/ohma_tokita_icon"
            app:layout_constraintTop_toTopOf="@id/ohma_tokita_icon"
            app:layout_constraintBottom_toBottomOf="@id/ohma_tokita_icon" />

        <View
            android:id="@+id/backgroundView2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/border"
            android:backgroundTint="@color/background"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            app:layout_constraintStart_toStartOf="@id/textView2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView2"
            app:layout_constraintHeight_percent="0.15" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:maxLines="3"
            android:padding="@dimen/padding_medium"
            android:text="@string/message"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/backgroundView2"
            app:layout_constraintBottom_toTopOf="@id/replyInteractionLayout"
            app:layout_constraintStart_toStartOf="@id/backgroundView2"
            app:layout_constraintEnd_toEndOf="@id/backgroundView2" />

        <LinearLayout
            android:id="@+id/replyInteractionLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/margin_medium"
            app:layout_constraintStart_toStartOf="@id/backgroundView2"
            app:layout_constraintBottom_toBottomOf="@id/backgroundView2">

            <ImageView
                android:id="@+id/like_icon2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/like_icon" />

            <ImageView
                android:id="@+id/reply_icon2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/reply_icon"
                android:layout_marginStart="@dimen/margin_large" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>